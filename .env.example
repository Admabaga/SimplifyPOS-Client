# URL base del backend (incluir /api/v1)
# Desarrollo local: usar proxy de Vite o apuntar directo
VITE_API_URL=http://localhost:8000/api/v1

# En producción (Render) se configura en el panel de la app
# VITE_API_URL=https://simplifypos-api.onrender.com/api/v1

# Minutos de INACTIVIDAD antes de cerrar sesión por seguridad (default 30).
# Se reinicia con cualquier clic o tecla: a un cajero trabajando no le salta.
# No es la vida de la sesión (esa la define el servidor y se renueva sola).
VITE_IDLE_TIMEOUT_MIN=30
